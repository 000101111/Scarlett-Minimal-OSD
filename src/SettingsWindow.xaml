<Window x:Class="ScarlettMonitorOSD.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scarlett OSD 设置"
        Width="400" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei, Bahnschrift"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>

    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseDown="Header_MouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="fc2_icon.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Scarlett OSD 设置" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <TextBlock Text="外观、增益控制与 Focusrite 协同" FontSize="11" Foreground="#71717A" Margin="28,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="Transparent" 
                        Foreground="#A1A1AA" BorderThickness="0" FontSize="14" FontWeight="Bold"
                        Cursor="Hand" Click="CloseButton_Click" VerticalAlignment="Top"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                    <!-- Group 1: Background Opacity -->
                    <Border Background="#202024" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="背景透明度 (Opacity)" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OpacityValueText" Text="100%" FontSize="13" FontWeight="Bold" Foreground="#EC3E4C" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100" 
                                    SmallChange="1" LargeChange="10"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock Text="0% 为纯透明（仅数字浮动），100% 为纯黑底色" FontSize="11" Foreground="#71717A" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Group 2: Display Duration -->
                    <Border Background="#202024" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="停留显示时长 (Duration)" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DurationValueText" Text="2.0 秒" FontSize="13" FontWeight="Bold" Foreground="#EC3E4C" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="DurationSlider" Minimum="1" Maximum="6" Value="2"
                                    SmallChange="0.5" LargeChange="1"
                                    ValueChanged="DurationSlider_ValueChanged"/>
                            <TextBlock Text="调节监听旋钮后，OSD 悬浮保持显示的时间" FontSize="11" Foreground="#71717A" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Group 3: Wheel Step & Safety Max Gain -->
                    <Border Background="#202024" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="滚轮步进幅度 (Volume Step)" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StepValueText" Text="1.0 dB" FontSize="13" FontWeight="Bold" Foreground="#EC3E4C" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="StepSlider" Minimum="0.5" Maximum="3.0" Value="1.0"
                                    SmallChange="0.5" LargeChange="0.5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    ValueChanged="StepSlider_ValueChanged"/>
                            <TextBlock Text="鼠标悬停在任务栏托盘区域滚动滚轮时的单格调节幅度" FontSize="11" Foreground="#71717A" Margin="0,6,0,8"/>

                            <Separator Background="#27272A" Margin="0,4,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="最大增益安全上限 (Max Gain Limit)" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MaxGainValueText" Text="0.0 dB" FontSize="13" FontWeight="Bold" Foreground="#EC3E4C" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="MaxGainSlider" Minimum="-12" Maximum="6" Value="0"
                                    SmallChange="1.0" LargeChange="1.0" TickFrequency="1.0" IsSnapToTickEnabled="True"
                                    ValueChanged="MaxGainSlider_ValueChanged"/>
                            <TextBlock Text="滚轮和软件控制允许达到的最高输出音量（默认 0.0 dB 保护听力与设备）" FontSize="11" Foreground="#71717A" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Group 4: FC2 Integration -->
                    <Border Background="#202024" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Focusrite Control 2 协同" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <CheckBox x:Name="AutoLaunchFc2Check" Content="启动 OSD 时自动静默拉起 FC2（免手动启动）" IsChecked="True"/>
                            <CheckBox x:Name="KillFc2OnExitCheck" Content="退出 OSD 时同时关闭 FC2" IsChecked="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="🔔 测试显示" Height="34" Margin="0,0,6,0"
                        Background="#27272A" Foreground="#FAFAFA" BorderThickness="0"
                        FontWeight="SemiBold" FontSize="12" Cursor="Hand"
                        Click="TestOsdButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Grid.Column="1" Content="保存并完成" Height="34" Margin="6,0,0,0"
                        Background="#EC3E4C" Foreground="#FFFFFF" BorderThickness="0"
                        FontWeight="SemiBold" FontSize="12" Cursor="Hand"
                        Click="SaveButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>

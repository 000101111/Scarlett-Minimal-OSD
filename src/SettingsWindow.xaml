<Window x:Class="ScarlettMonitorOSD.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}"
        Width="400" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei, Bahnschrift"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>

    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseDown="Header_MouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="fc2_icon.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource SettingsSubtitle}" FontSize="11" Foreground="#71717A" Margin="28,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="Transparent" 
                        Foreground="#A1A1AA" BorderThickness="0" FontSize="14" FontWeight="Bold"
                        ToolTip="{DynamicResource Close}" Cursor="Hand" Click="CloseButton_Click" VerticalAlignment="Top"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                    <Border Background="#202024" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LanguageLabel}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged" MinHeight="28">
                                <ComboBoxItem Content="{DynamicResource LanguageSystem}"/>
                                <ComboBoxItem Content="简体中文"/>
                                <ComboBoxItem Content="English"/>
                            </ComboBox>
                            <TextBlock Text="{DynamicResource LanguageHelp}" FontSize="11" Foreground="#71717A" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Group 1: Background Opacity -->
                    <Border Background="#202024" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource OpacityLabel}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OpacityValueText" Text="100%" FontSize="13" FontWeight="Bold" Foreground="#EC3E4C" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100" 
                                    SmallChange="1" LargeChange="10"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock Text="{DynamicResource OpacityHelp}" FontSize="11" Foreground="#71717A" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Group 2: Display Duration -->
                    <Border Background="#202024" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource DurationLabel}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DurationValueText" Text="2.0 s" FontSize="13" FontWeight="Bold" Foreground="#EC3E4C" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="DurationSlider" Minimum="1" Maximum="6" Value="2"
                                    SmallChange="0.5" LargeChange="1"
                                    ValueChanged="DurationSlider_ValueChanged"/>
                            <TextBlock Text="{DynamicResource DurationHelp}" FontSize="11" Foreground="#71717A" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Group 3: Wheel Step & Safety Max Gain -->
                    <Border Background="#202024" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource StepLabel}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StepValueText" Text="1.0 dB" FontSize="13" FontWeight="Bold" Foreground="#EC3E4C" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="StepSlider" Minimum="0.5" Maximum="3.0" Value="1.0"
                                    SmallChange="0.5" LargeChange="0.5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    ValueChanged="StepSlider_ValueChanged"/>
                            <TextBlock Text="{DynamicResource StepHelp}" FontSize="11" Foreground="#71717A" Margin="0,6,0,8"/>

                            <Separator Background="#27272A" Margin="0,4,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource MaxGainLabel}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MaxGainValueText" Text="0.0 dB" FontSize="13" FontWeight="Bold" Foreground="#EC3E4C" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="MaxGainSlider" Minimum="-12" Maximum="6" Value="0"
                                    SmallChange="1.0" LargeChange="1.0" TickFrequency="1.0" IsSnapToTickEnabled="True"
                                    ValueChanged="MaxGainSlider_ValueChanged"/>
                            <TextBlock Text="{DynamicResource MaxGainHelp}" FontSize="11" Foreground="#71717A" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Group 4: FC2 Integration -->
                    <Border Background="#202024" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Fc2Label}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <CheckBox x:Name="AutoLaunchFc2Check" IsChecked="True"><TextBlock Text="{DynamicResource AutoLaunchFc2}"/></CheckBox>
                            <CheckBox x:Name="KillFc2OnExitCheck" IsChecked="False"><TextBlock Text="{DynamicResource KillFc2OnExit}"/></CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{DynamicResource TestDisplay}" Height="34" Margin="0,0,6,0"
                        Background="#27272A" Foreground="#FAFAFA" BorderThickness="0"
                        FontWeight="SemiBold" FontSize="12" Cursor="Hand"
                        Click="TestOsdButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Grid.Column="1" Content="{DynamicResource SaveDone}" Height="34" Margin="6,0,0,0"
                        Background="#EC3E4C" Foreground="#FFFFFF" BorderThickness="0"
                        FontWeight="SemiBold" FontSize="12" Cursor="Hand"
                        Click="SaveButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
